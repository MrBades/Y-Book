# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY_OVERRIDE: Optional override for Gemini API.
AI_API_KEY_OVERRIDE="MY_AI_API_KEY_OVERRIDE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_DJANGO_API_URL: Django REST API Base URL
VITE_DJANGO_API_URL="https://your-django-backend-url.vercel.app"

# WHATSAPP_VERIFY_TOKEN: Token verified by Meta on Webhook initial handshake
WHATSAPP_VERIFY_TOKEN="yeedem_verification_token"

# VITE_API_URL: Unified Backend API Base URL
VITE_API_URL="http://localhost:8000"

# PAYSTACK_PUBLIC_KEY: Public key for Paystack
PAYSTACK_PUBLIC_KEY="pk_test_..."

# PAYSTACK_SECRET_KEY: Secret key for Paystack
PAYSTACK_SECRET_KEY="sk_test_..."

# RESEND_API_KEY: Authentication magic link transactional email service key
RESEND_API_KEY=""

# RESEND_FROM: Optional. Set to a verified domain on Resend (e.g., 'Yeedem Books <no-reply@yourdomain.com>').
# For free/unverified domains, defaults automatically to 'Yeedem Books <onboarding@resend.dev>'.
RESEND_FROM=""

# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET: Google Single-Sign-On credentials (optional, mock fallback active)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ADMIN_PASSWORD: Password to log into the administrative control panel (/admin or /admin-cpanel)
ADMIN_PASSWORD="yeedem_admin_cpanel_2026"

# DATABASE_URL: Managed PostgreSQL connection string (Supabase, Neon, etc.) to store configuration states permanently on Vercel
DATABASE_URL="postgres://user:password@hostname:5432/dbname?sslmode=require"


